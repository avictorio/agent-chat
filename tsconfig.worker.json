{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "erasableSyntaxOnly": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "WebWorker"
    ],
    "types": [],
    "skipLibCheck": true,
    "paths": {
      "@chat/contract": [
        "./contract/src/index.ts"
      ]
    }
  },
  "files": [
    "types/worker-env.d.ts",
    "types/room-methods.d.ts"
  ],
  "include": [
    "worker/**/*.ts",
    "worker/**/*.js"
  ]
}

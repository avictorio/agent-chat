{
  "name": "agent-chat",
  "private": true,
  "description": "chat.victorio.cloud: chat rooms for AI agents and people, on Cloudflare Workers",
  "scripts": {
    "build": "npm run build --prefix web",
    "check": "node scripts/check-worker.js && node scripts/check-inline.js && tsc -p tsconfig.worker.json",
    "lint": "web/node_modules/.bin/oxlint -c web/.oxlintrc.json --report-unused-disable-directives --deny-warnings web/app/src contract/src",
    "check:config": "node scripts/check-config.js",
    "test": "npm --prefix web test",
    "test:api": "node tests/api/api.test.js",
    "test:unit": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/unit/register.mjs --test \"tests/unit/*.test.mjs\""
  },
  "devDependencies": {
    "acorn": "8.19.0",
    "acorn-walk": "8.3.4",
    "typescript": "7.0.2",
    "wrangler": "4.166.0"
  }
}

{
  "name": "agent-chat",
  "private": true,
  "description": "chat.victorio.cloud: chat rooms for AI agents and people, on Cloudflare Workers",
  "scripts": {
    "build": "npm run build --prefix web",
    "check": "node scripts/check-worker.js && node scripts/check-inline.js",
    "check:config": "node scripts/check-config.js",
    "test": "npm --prefix web test",
    "test:api": "node tests/api.test.js"
  },
  "devDependencies": {
    "acorn": "8.19.0",
    "acorn-walk": "8.3.4",
    "wrangler": "4.166.0"
  }
}

{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "off",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "react/immutability": "error",
    "react/refs": "error",
    "react/preserve-manual-memoization": "error",
    "react/purity": "error",
    "react/use-memo": "error",
    "typescript/no-explicit-any": "error"
  },
  "ignorePatterns": [
    "app/dist/**",
    "**/node_modules/**",
    "tests/shots/**"
  ],
  "overrides": [
    {
      "files": [
        "**/worker/**"
      ],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    },
    {
      "files": [
        "**/*Arena3D.tsx",
        "**/games/three/**",
        "**/games/battleship/ocean.tsx",
        "**/games/battleship/ships.tsx",
        "**/games/battleship/fire.tsx",
        "**/games/lightcycles/cycles.tsx"
      ],
      "rules": {
        "react/immutability": "off"
      }
    }
  ]
}

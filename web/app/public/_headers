# Workers Static Assets: hashed build files never change under a name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The app icons: plain names that can change with a deploy, so a day.
/icons/*
  Cache-Control: public, max-age=86400

# The Muse gadget guide's screenshots (/muse-gadget): plain names, so a day.
/muse-gadget/*
  Cache-Control: public, max-age=86400

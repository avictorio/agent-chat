    "status": 403,
    "type": "json",
    "keys": [
      "error"
    ],
    "error": "This invite link isn't valid for this room."
  },
  "read: revoked token": {
    "status": 403,
    "type": "json",
    "keys": [
      "error"
    ],
    "error": "This invite link has been revoked. Ask the room owner for a new one."
  },
